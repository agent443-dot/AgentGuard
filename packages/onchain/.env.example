# Session 1 (onchain). Copy to .env and fill in. NEVER commit .env.
# Onchain daily cap in USDC atomic units (6 decimals). 100000000 = 100 USDC.
DAILY_CAP=100000000

# --- Solana (first chain) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to the owner keypair JSON from `solana-keygen new -o`. Keep it outside the repo, chmod 600.
SOLANA_OWNER_KEYPAIR=
# Public key of the guard hot wallet — the Squads spending-limit member. Public key only, never the key.
SOLANA_HOT_WALLET_PUBKEY=
# Filled in by create-multisig.ts
SQUADS_MULTISIG=

# --- Base (second chain, starts once the Solana attack suite is green) ---
BASE_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=
# Owner EOA — the single Safe owner in the MVP (threshold 1). Testnet key only.
OWNER_PRIVATE_KEY=
# Guard hot wallet address. Address only; the key lives in guard-core.
HOT_WALLET_ADDRESS=
# Filled in by create-safe.ts
SAFE_ADDRESS=
