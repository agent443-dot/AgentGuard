# Copy to .env and fill in. NEVER commit .env.
# Onchain daily cap in USDC atomic units (6 decimals). 100000000 = 100 USDC.
DAILY_CAP=100000000

# --- Solana (first chain) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# The owner key. Either a keypair JSON path from `solana-keygen new -o` (devnet; keep it outside the
# repo, chmod 600) or a Ledger, in the Solana CLI form: usb://ledger?key=0 (mainnet). See README.
SOLANA_OWNER_KEYPAIR=
# Public key of the guard hot wallet — the Squads spending-limit member. Public key only, never the key.
SOLANA_HOT_WALLET_PUBKEY=
# Filled in by create-multisig.ts
SQUADS_MULTISIG=
# USDC on this cluster, from Circle's official list (verified values: packages/shared/src/addresses.ts)
USDC_MINT=

# --- Base (second chain) ---
# 84532 = Base Sepolia, 8453 = Base mainnet
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# Who signs as the single Safe owner (threshold 1): `key` or `ledger`. Mainnet (8453) needs `ledger`.
OWNER_SIGNER=key
# key: the owner EOA's private key. Testnet only, read from this file and never passed on the
# command line.
OWNER_PRIVATE_KEY=
# ledger: the account on the device (Ledger Live's first Ethereum account is 44'/60'/0'/0/0), and a
# separate key that only pays gas. It owns nothing: the Safe still needs the owner's signature.
OWNER_LEDGER_PATH=44'/60'/0'/0/0
EXECUTOR_PRIVATE_KEY=
# Guard hot wallet address: the Allowance Module delegate. Address only; the key lives in guard-core.
HOT_WALLET_ADDRESS=
# Filled in by create-safe.ts
SAFE_ADDRESS=
# Only while shared/addresses.ts has no verified value for the chain (CR-005). Copy from the official
# lists, never from memory: Circle for USDC, safe-modules-deployments for the Allowance Module.
BASE_USDC=
BASE_ALLOWANCE_MODULE=

# --- Robinhood Chain ---
# The same ROBINHOOD_* names as guard-core's .env. There is no owner key: on Robinhood the owner signs
# in Phantom, through the signing page (D4). USDG and the Allowance Module come from
# shared/addresses.ts. eip155:46630 = testnet, eip155:4663 = mainnet.
ROBINHOOD_CHAIN=eip155:46630
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Filled in once the owner has created the Safe on the signing page.
ROBINHOOD_SAFE_ADDRESS=
# The guard hot wallet's address only; its key file is in guard-core (ROBINHOOD_HOT_WALLET_KEY_FILE).
ROBINHOOD_HOT_WALLET_ADDRESS=
