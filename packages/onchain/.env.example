# Session 1 (onchain). Copy to .env and fill in. NEVER commit .env.
# Onchain daily cap in USDC atomic units (6 decimals). 100000000 = 100 USDC.
DAILY_CAP=100000000

# --- Solana (first chain) ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# The owner key. Either a keypair JSON path from `solana-keygen new -o` (devnet; keep it outside the
# repo, chmod 600) or a Ledger, in the Solana CLI form: usb://ledger?key=0 (mainnet). See README.
SOLANA_OWNER_KEYPAIR=
# Public key of the guard hot wallet — the Squads spending-limit member. Public key only, never the key.
SOLANA_HOT_WALLET_PUBKEY=
# Filled in by create-multisig.ts
SQUADS_MULTISIG=

# --- Base (second chain) ---
# 84532 = Base Sepolia, 8453 = Base mainnet
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# Owner EOA, the single Safe owner in the MVP (threshold 1). Testnet key only, read from this file and
# never passed on the command line.
OWNER_PRIVATE_KEY=
# Guard hot wallet address: the Allowance Module delegate. Address only; the key lives in guard-core.
HOT_WALLET_ADDRESS=
# Filled in by create-safe.ts
SAFE_ADDRESS=
# Only while shared/addresses.ts has no verified value for the chain (CR-005). Copy from the official
# lists, never from memory: Circle for USDC, safe-modules-deployments for the Allowance Module.
BASE_USDC=
BASE_ALLOWANCE_MODULE=
