# Copy to .env and fill in. NEVER commit .env.
# This package holds NO wallet keys and NO policy logic.
# https:// for a hosted guard-core; plain http:// is accepted only for localhost.
GUARD_URL=http://localhost:8787
AGENT_ID=
AGENT_TOKEN=
# Or a file holding the token, readable by you only (chmod 600). `setup` writes one.
# AGENT_TOKEN_FILE=
# CAIP-2 chain used by `transfer` when the agent omits it. Default: Solana devnet.
DEFAULT_CHAIN=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Others: eip155:84532 (Base Sepolia), eip155:46630 (Robinhood Chain testnet, pays USDG). Must be a
# chain guard-core runs; the server warns at startup if not.
# USDC on Base mainnet only, while shared has no verified address for it. Ignored on other chains.
# BASE_USDC=
# stdio | http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8789
# Binding to a non-loopback MCP_HTTP_HOST is refused unless this is true.
MCP_HTTP_ALLOW_REMOTE=false
# HTTP requests per minute per client address.
MCP_HTTP_RATE_LIMIT=60
# Required when MCP_TRANSPORT=http. Generate with: openssl rand -hex 32
# MCP_HTTP_TOKEN=
LOG_LEVEL=info
