# Copy to .env and fill in. NEVER commit .env.
PORT=8788
# Interface for the hooks. Keep it private: only guard-core needs to reach them.
HOST=127.0.0.1
LOG_LEVEL=info

# From BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to approve, pause and kill. Everyone else is ignored.
OWNER_TELEGRAM_IDS=

# --- guard-core ---
GUARD_URL=http://localhost:8787
# Bearer token for /v1/bot/* and /v1/admin/* calls
GUARD_BOT_TOKEN=
GUARD_ADMIN_TOKEN=

# Must match guard-core's BOT_WEBHOOK_SECRET (HMAC-SHA256 of the body, header X-Guard-Signature).
# guard-core's BOT_TOKEN and ADMIN_TOKEN go in GUARD_BOT_TOKEN and GUARD_ADMIN_TOKEN above.
BOT_WEBHOOK_SECRET=

# Requests per minute per client address on the hooks. Only guard-core calls them; each payment
# costs at most two (an approval request and an intent event).
HOOK_RATE_LIMIT_PER_MINUTE=300

# Notify on executed payments at or above this amount, in dollar atomic units (USDC or USDG). 1000000 = $1.
NOTIFY_ABOVE_AMOUNT=1000000

# guard-core's public https address. A payment that needs a passkey gets an "Approve with passkey"
# button to <this>/owner/approve/<intentId>; without it, such a payment can only be rejected here.
GUARD_PUBLIC_URL=

# Weekly report to every owner: the last 7 days, on this weekday (0 = Sunday) at this hour (UTC).
# Set both, or leave both empty for no weekly report. /report works either way.
REPORT_WEEKDAY=
REPORT_HOUR_UTC=

# --- Onchain kill in Phantom (ADR 003). All public values; leave SIGN_PAGE_URL empty for no button.
# The signing page from packages/onchain/web, https only, with no query.
SIGN_PAGE_URL=
# Which cluster the page opens on. Must match guard-core's SOLANA_CHAIN.
SOLANA_CHAIN=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# With SIGN_PAGE_URL set, configure at least one chain completely: both Solana keys, the Robinhood
# Safe, or both. The same values as in guard-core and onchain.
SQUADS_MULTISIG=
SOLANA_HOT_WALLET_PUBKEY=
# eip155:46630 (Robinhood Chain testnet) or eip155:4663 (mainnet). Must match guard-core.
ROBINHOOD_CHAIN=eip155:46630
# The owner's Safe on Robinhood Chain. The page knows the hot wallet, so the link names only this.
ROBINHOOD_SAFE_ADDRESS=
