# Copy to .env and fill in. NEVER commit .env.
PORT=8787
# 127.0.0.1 unless set. A deployment sets 0.0.0.0 behind its own TLS and firewall.
HOST=127.0.0.1
# A deployment sets PUBLIC_PORT to serve the agent routes alone on PUBLIC_HOST:PUBLIC_PORT, and the
# admin and bot routes alone on HOST:PORT. Unset, HOST:PORT serves every route.
PUBLIC_PORT=
PUBLIC_HOST=0.0.0.0
LOG_LEVEL=info

# --- Solana. The keypair file is the ONLY place this key exists (later: KMS). ---
# CAIP-2 id of the cluster this guard pays on: devnet (default) or mainnet-beta.
SOLANA_CHAIN=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to the hot wallet keypair JSON. Keep it outside the repo, chmod 600.
SOLANA_HOT_WALLET_KEYPAIR=
SQUADS_MULTISIG=

# --- local development ---
# true runs offline stub chains: nothing is signed and no money moves. Never in production.
GUARD_STUB_CHAINS=false
# How often pending approvals and unused x402 approvals are expired, in milliseconds.
EXPIRY_SWEEP_MS=30000
# Requests per minute: per IP on every route, and per agent token on /v1/agent/* as well.
RATE_LIMIT_PER_IP=120
RATE_LIMIT_PER_AGENT=60

# --- Base. Same rule for this key. ---
# Base is off unless BASE_CHAIN is set: eip155:84532 (Base Sepolia) or eip155:8453 (Base). Once set,
# guard-core refuses to start until every value below is filled in.
BASE_CHAIN=
BASE_RPC_URL=https://sepolia.base.org
# Path to a file holding the hot wallet's private key, 0x and 64 hex digits. Keep it outside the
# repo, chmod 600. (A raw HOT_WALLET_PRIVATE_KEY is refused at startup.)
BASE_HOT_WALLET_KEY_FILE=
# The owner's Safe, from onchain's create-safe.
SAFE_ADDRESS=
# Only until shared/addresses.ts has verified values for the chain (CR-005). Read them from Circle
# and from safe-modules-deployments, never from memory.
BASE_USDC=
BASE_ALLOWANCE_MODULE=

# --- Robinhood Chain (CR-007). Same rule for this key. ---
# Off unless ROBINHOOD_CHAIN is set: eip155:46630 (testnet) or eip155:4663 (mainnet). Its dollar is
# Paxos's USDG, and that address and the Allowance Module come from shared/addresses.ts only.
ROBINHOOD_CHAIN=
ROBINHOOD_RPC_URL=
# The owner's Safe on Robinhood Chain.
ROBINHOOD_SAFE_ADDRESS=
# Path to a file holding the hot wallet's private key, 0x and 64 hex digits. chmod 600.
ROBINHOOD_HOT_WALLET_KEY_FILE=

# --- receipts and passkeys (both off unless set) ---
# Path to an Ed25519 private key in PEM that signs a receipt for every executed payment. Generate it
# with: openssl genpkey -algorithm ed25519 -out receipt.pem. Keep it apart from the hot wallet keys.
RECEIPT_SIGNING_KEY_FILE=
# At or above this amount (atomic units), only the owner's passkey can approve. Enrol one first.
PASSKEY_ABOVE=
# guard-core's public address, which the passkey is bound to, e.g. guard.example.com and
# https://guard.example.com.
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# --- auth (SPEC: Authorization: Bearer <token>) ---
# Admin token for /v1/admin/*, bot token for /v1/bot/*. Agent tokens are per-agent rows in the DB.
ADMIN_TOKEN=
BOT_TOKEN=

# --- telegram-bot webhook ---
BOT_URL=http://localhost:8788
BOT_WEBHOOK_SECRET=

# --- database (MVP: SQLite) ---
# Fine for devnet. On mainnet it must be on a persistent volume, outside the repo and any temp
# directory, e.g. file:/var/lib/agentguard/guard.db; guard-core refuses to start otherwise.
DATABASE_URL=file:./data/guard.db
