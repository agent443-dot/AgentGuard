# Session 2 (guard-core). Copy to .env and fill in. NEVER commit .env.
PORT=8787
# 127.0.0.1 unless set. A deployment sets 0.0.0.0 behind its own TLS and firewall.
HOST=127.0.0.1
LOG_LEVEL=info

# --- Solana. The keypair file is the ONLY place this key exists (later: KMS). ---
# CAIP-2 id of the cluster this guard pays on: devnet (default) or mainnet-beta.
SOLANA_CHAIN=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to the hot wallet keypair JSON. Keep it outside the repo, chmod 600.
SOLANA_HOT_WALLET_KEYPAIR=
SQUADS_MULTISIG=

# --- local development ---
# true runs offline stub chains: nothing is signed and no money moves. Never in production.
GUARD_STUB_CHAINS=false
# How often pending approvals and unused x402 approvals are expired, in milliseconds.
EXPIRY_SWEEP_MS=30000

# --- Base. Same rule for this key. ---
# Base is off unless BASE_CHAIN is set: eip155:84532 (Base Sepolia) or eip155:8453 (Base). Once set,
# guard-core refuses to start until every value below is filled in.
BASE_CHAIN=
BASE_RPC_URL=https://sepolia.base.org
# The hot wallet's private key, 0x and 64 hex digits. It exists only in this file.
HOT_WALLET_PRIVATE_KEY=
# The owner's Safe, from onchain's create-safe (HUMAN-12).
SAFE_ADDRESS=
# Only until shared/addresses.ts has verified values for the chain (CR-005). Read them from Circle
# and from safe-modules-deployments, never from memory.
BASE_USDC=
BASE_ALLOWANCE_MODULE=

# --- auth (SPEC: Authorization: Bearer <token>) ---
# Admin token for /v1/admin/*, bot token for /v1/bot/*. Agent tokens are per-agent rows in the DB.
ADMIN_TOKEN=
BOT_TOKEN=

# --- telegram-bot webhook ---
BOT_URL=http://localhost:8788
BOT_WEBHOOK_SECRET=

# --- database (MVP: SQLite) ---
DATABASE_URL=file:./data/guard.db

# --- optional: Tenderly simulation for the EVM adapter. Unset means eth_call. ---
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_ACCESS_KEY=
