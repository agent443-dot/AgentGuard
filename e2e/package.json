{
  "name": "@agentguard/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end and attack tests.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "dev:check": "tsx src/dev-check.ts",
    "paywall": "tsx --env-file=.env src/devnet-paywall.ts",
    "paywall:base": "PAYWALL_EVM_CHAIN=eip155:84532 tsx --env-file=.env src/evm-paywall.ts",
    "paywall:robinhood": "PAYWALL_EVM_CHAIN=eip155:46630 tsx --env-file=.env src/evm-paywall.ts"
  },
  "devDependencies": {
    "@agentguard/guard-core": "workspace:*",
    "@agentguard/mcp-server": "workspace:*",
    "@agentguard/onchain": "workspace:*",
    "@agentguard/shared": "workspace:*",
    "@agentguard/telegram-bot": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solana/kit": "^8.6.0",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/svm": "^2.29.0",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  }
}
