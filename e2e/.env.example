# Only `pnpm --filter @agentguard/e2e paywall` reads this. Copy to .env. NEVER commit .env.

# Keypair JSON of the account that pays the devnet network fee when the paywall settles a payment.
# It needs devnet SOL (solana airdrop 1). The owner keypair works. Keep it outside the repo.
PAYWALL_FEE_PAYER_KEYPAIR=
# Who the paywall is paid: a devnet address, e.g. the owner. For x402 the policy's gate is
# allowedDomains (add "127.0.0.1"); allowedRecipients applies to direct transfers only.
PAYWALL_PAY_TO=
# Price in USDC atomic units. 500000 = 0.5 USDC, under a 1 USDC approval threshold.
PAYWALL_AMOUNT=500000
PAYWALL_PORT=8790
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- EVM paywalls (`paywall:base` for Base Sepolia, `paywall:robinhood` for Robinhood testnet) ---
# Testnet key of the account that pays gas when the paywall settles. It needs the testnet's ETH.
# Never a mainnet key. It is read from this file and never printed. The token is always the chain's
# dollar from shared/addresses.ts: USDC on Base Sepolia, USDG on Robinhood Chain testnet.
PAYWALL_EVM_KEY=
# Who the paywall is paid, e.g. the owner's address.
PAYWALL_BASE_PAY_TO=
PAYWALL_BASE_PORT=8791
BASE_RPC_URL=https://sepolia.base.org
PAYWALL_ROBINHOOD_PAY_TO=
PAYWALL_ROBINHOOD_PORT=8792
# Empty: the chain's public RPC (testnet or mainnet, by the script you run).
ROBINHOOD_RPC_URL=
# `paywall:robinhood-mainnet` (real USDG, the owner's pilot): the fee payer key comes from this file,
# never from PAYWALL_EVM_KEY. It needs a little Robinhood Chain ETH, and nothing else.
PAYWALL_EVM_KEY_FILE=
